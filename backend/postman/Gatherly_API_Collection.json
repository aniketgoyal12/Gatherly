              "mode": "raw",
              "raw": "{\n  \"title\": \"Gatherly Postman E2E Summit\",\n  \"description\": \"End-to-end automated API testing summit covering workflows and QR verification.\",\n  \"category\": \"Technology\",\n  \"venueId\": \"{{venueId}}\",\n  \"startDate\": \"2026-12-10T09:00:00.000Z\",\n  \"endDate\": \"2026-12-10T18:00:00.000Z\",\n  \"capacity\": 150,\n  \"ticketPrice\": 0\n}"
            },
            "url": "{{baseUrl}}/events"
          }
