  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "0.1 API Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Health flag is true', () => pm.expect(res.success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Authentication (Login All 4 Seeded Roles)",
      "item": [
        {
          "name": "1.1 Login — Organizer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Organizer Login 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Access token returned', () => pm.expect(res.data.accessToken).to.be.a('string'));",
                  "pm.environment.set('organizerToken', res.data.accessToken);",
                  "pm.collectionVariables.set('organizerToken', res.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@gatherly.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "1.2 Login — Super Admin",
