      "name": "0. Health Check & Gateway Status",
      "item": [
        {
          "name": "0.1 API Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Health flag is true', () => pm.expect(res.success).to.eql(true));",
                  "pm.test('Service status is healthy', () => {",
                  "  pm.expect(res.data.status).to.eql('healthy');",
                  "  pm.expect(res.data.uptime).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
