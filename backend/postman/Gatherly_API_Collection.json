{
  "info": {
    "name": "Gatherly Backend API — End-to-End Test Suite",
    "description": "Complete ordered Postman collection for Gatherly MERN Backend with automated token & ID chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "organizerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "attendeeToken", "value": "", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "venueId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "registrationId", "value": "", "type": "string" },
    { "key": "qrToken", "value": "", "type": "string" },
    { "key": "taskId", "value": "", "type": "string" }
