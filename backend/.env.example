# Gatherly Backend Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://gatherly_dev:your_password@cluster0.mongodb.net/gatherly?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_chars_min
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_64_chars_min

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholderKeyId123
RAZORPAY_KEY_SECRET=placeholderRazorpaySecretKey456
RAZORPAY_WEBHOOK_SECRET=placeholderWebhookSecret789

# Microservices & Crypto
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal_microservice_shared_secret_token
QR_HMAC_SECRET=secret_for_signing_qr_code_payloads_32_chars

# Cloudinary Media Storage (Optional in local dev - auto falls back to local /uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP / Nodemailer - auto falls back to in-memory console preview if omitted)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Gatherly Notifications" <no-reply@gatherly.events>

# Redis (Optional - auto falls back to in-memory bus when offline)
REDIS_URL=redis://localhost:6379
